{
  "name": "@knit-ui/core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/knit-ui.cjs",
  "module": "./dist/knit-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
